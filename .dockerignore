# Keep the build context small and avoid ever baking secrets into a layer.

**/__pycache__/
**/*.pyc
backend/.venv/
backend/media/
backend/.uploads/
backend/tests/
backend/.pytest_cache/
backend/**/*.sqlite3

frontend/node_modules/
frontend/dist/

.git/
.github/
docs/
*.md
.env
.env.*
!.env.example
