# ─────────────────────────────────────────────────────────────
# Aura X — environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- Core ----------------------------------------------------
APP_ENV=development                 # development | production
DEBUG=true
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (PostgreSQL) -----------------------------------
# Local dev:  postgresql+psycopg://postgres:postgres@localhost:5432/aurax
# Railway injects DATABASE_URL automatically (postgresql://...) and it is
# normalised to the psycopg3 driver at runtime.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aurax

# --- URLs / CORS ---------------------------------------------
FRONTEND_URL=http://localhost:5173
# Comma separated. Leave empty when frontend is served by the backend.
CORS_ORIGINS=http://localhost:5173

# --- Auth / cookies ------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                 # MUST be true in production (HTTPS)
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- Green PIN (financial unlock) ----------------------------
FINANCE_UNLOCK_MINUTES=5
GREEN_PIN_MAX_ATTEMPTS=5
GREEN_PIN_LOCKOUT_SECONDS=300

# --- Google OAuth (optional; sign-in with Google) -------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorised redirect URI configured in Google Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Phone / OTP sign-in ---------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45

# Delivery channel: auto (WhatsApp first, then SMS) | whatsapp | sms
OTP_CHANNEL=auto

# IMPORTANT: with none of the blocks below filled in, no code can be
# delivered. In development the code comes back in the API response
# (debug_code) so the flow still works; in production the endpoint now
# returns 503 instead of silently pretending a message was sent.

# --- WhatsApp: Meta Cloud API (recommended) --------------------
# Free to start and needs no TRAI/DLT registration, unlike A2P SMS in India.
#  1. developers.facebook.com -> create app -> add "WhatsApp"
#  2. copy the Phone number ID and a permanent System User access token
#  3. WhatsApp Manager -> Message templates -> create an *Authentication*
#     template (name it otp_login), with the "Copy code" button, and wait
#     for approval (usually minutes)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_login
WHATSAPP_TEMPLATE_LANG=en_US
# Set false only if your approved template has no "Copy code" button.
WHATSAPP_OTP_COPY_BUTTON=true
WHATSAPP_API_VERSION=v21.0

# --- Twilio (SMS and/or WhatsApp) ------------------------------
# One account covers both. TWILIO_WHATSAPP_FROM may be the sandbox number
# (whatsapp:+14155238886) while testing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# --- MSG91 (SMS, India) ----------------------------------------
# Needs a DLT-registered OTP template on the MSG91 dashboard.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=AURAXX
MSG91_OTP_VAR=otp

# --- Generic SMS relay -----------------------------------------
# Any gateway fronted by a small relay that accepts {to, message} JSON.
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=AuraX

# --- SMTP (password reset / verification e-mail) --------------
# When unset, e-mails are written to the application log instead (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aura X <no-reply@aurax.app>"
SMTP_TLS=true

# --- Object storage (photos) ---------------------------------
# STORAGE_BACKEND=local uses ./media (development only — Railway's disk
# is ephemeral). Use s3 with any S3-compatible provider in production.
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=aurax-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10

# --- Misc -----------------------------------------------------
SERVE_FRONTEND=false                # true in the Docker/Railway image
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
